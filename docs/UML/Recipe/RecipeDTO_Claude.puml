@startuml
'https://plantuml.com/class-diagram
' Food Recipe App (Community) 피그마 기반 DTO 설계
' 규칙
'  - 최상위 API 입출력: XxxRequest / XxxResponse
'  - 다른 DTO 안에 들어가는 조각: XxxDto
'  - 이미지는 URL(String), ID는 Long 으로 통일
'  - 로그인 사용자 식별(userId)은 토큰에서 꺼내므로 Request에 넣지 않음

left to right direction
skinparam classAttributeIconSize 0

' ===================== Common =====================
package common {
    class "PageResponse<T>" as PageResponse {
        + content: List<T>
        + page: int
        + size: int
        + totalElements: long
        + hasNext: boolean
    }

    class AuthorSummaryDto {
        + userId: Long
        + name: String
        + profileImageUrl: String
    }

    class RecipeCardDto {
        + recipeId: Long
        + title: String
        + imageUrl: String
        + rating: double
        + cookTimeMinutes: int
        + bookmarked: boolean
        + author: AuthorSummaryDto
    }

    class CategoryDto {
        + categoryId: Long
        + name: String
    }

    RecipeCardDto "1" *-- "1" AuthorSummaryDto
    note bottom of RecipeCardDto
      Home / Search / Search Result / Saved / Profile
      카드 전부 이 DTO 하나로 재사용
    end note
}

' ===================== Auth =====================
package auth {
    enum OAuthProvider {
        GOOGLE
        FACEBOOK
    }

    class SignInRequest {
        + email: String
        + password: String
    }

    class SignUpRequest {
        + name: String
        + email: String
        + password: String
        + confirmPassword: String
        + termsAgreed: boolean
    }

    class OAuthSignInRequest {
        + provider: OAuthProvider
        + idToken: String
    }

    class AuthTokenResponse {
        + accessToken: String
        + refreshToken: String
        + expiresIn: long
        + newUser: boolean
    }

    OAuthSignInRequest --> OAuthProvider
    note bottom of OAuthSignInRequest
      소셜 로그인/가입은 엔드포인트 1개.
      처음 오는 사용자면 서버가 가입 처리 후
      AuthTokenResponse.newUser = true
    end note
}

' ===================== Home =====================
package home {
    class HomeResponse {
        + me: AuthorSummaryDto
        + categories: List<CategoryDto>
        + recipes: List<RecipeCardDto>
        + newRecipes: List<RecipeCardDto>
    }

    HomeResponse "1" *-- "1" AuthorSummaryDto : me
    HomeResponse "1" *-- "0..*" CategoryDto
    HomeResponse "1" *-- "0..*" RecipeCardDto : recipes / newRecipes
}

' ===================== Search / Filter =====================
package search {
    enum RecipeSort {
        NEWEST
        OLDEST
        POPULARITY
    }

    class RecipeSearchRequest {
        + keyword: String
        + sort: RecipeSort
        + minRating: Integer
        + categoryId: Long
        + page: int
        + size: int
    }

    RecipeSearchRequest --> RecipeSort
    note bottom of RecipeSearchRequest
      sort / minRating / categoryId 가 null 이면 "All"
      minRating: 1~5 (@Min(1) @Max(5))
      응답: PageResponse<RecipeCardDto>
      ("255 results" = totalElements)
    end note
}

' ===================== Recipe Detail =====================
package recipe {
    class RecipeDetailResponse {
        + recipeId: Long
        + title: String
        + imageUrl: String
        + videoUrl: String
        + rating: double
        + reviewCount: long
        + cookTimeMinutes: int
        + servings: int
        + bookmarked: boolean
        + author: RecipeAuthorDto
        + ingredients: List<IngredientDto>
        + steps: List<StepDto>
    }

    class RecipeAuthorDto {
        + userId: Long
        + name: String
        + profileImageUrl: String
        + location: String
        + following: boolean
    }

    class IngredientDto {
        + name: String
        + imageUrl: String
        + amount: double
        + unit: String
    }

    class StepDto {
        + stepNumber: int
        + description: String
    }

    RecipeDetailResponse "1" *-- "1" RecipeAuthorDto
    RecipeDetailResponse "1" *-- "1..*" IngredientDto
    RecipeDetailResponse "1" *-- "1..*" StepDto

    package more {
        class RatingRequest {
            + score: int
        }

        class RatingResponse {
            + recipeId: Long
            + myScore: int
            + averageRating: double
        }

        class ShareLinkResponse {
            + recipeId: Long
            + shareUrl: String
        }

        class BookmarkResponse {
            + recipeId: Long
            + bookmarked: boolean
        }

        note bottom of RatingRequest
          score: 1~5
          recipeId 는 PathVariable
        end note
        note bottom of BookmarkResponse
          북마크 아이콘 / Unsave 메뉴 토글 결과.
          Saved 목록은 PageResponse<RecipeCardDto>
        end note
    }
}

' ===================== Review =====================
package review {
    enum ReactionType {
        LIKE
        DISLIKE
    }

    class ReviewCreateRequest {
        + content: String
    }

    class ReactionRequest {
        + type: ReactionType
    }

    class ReviewListResponse {
        + commentCount: long
        + savedCount: long
        + reviews: PageResponse<ReviewDto>
    }

    class ReviewDto {
        + reviewId: Long
        + writer: AuthorSummaryDto
        + content: String
        + createdAt: LocalDateTime
        + likeCount: int
        + dislikeCount: int
        + myReaction: ReactionType
    }

    ReviewListResponse "1" *-- "0..*" ReviewDto
    ReviewDto "1" *-- "1" AuthorSummaryDto : writer
    ReviewDto --> ReactionType
    ReactionRequest --> ReactionType
}

' ===================== Notification =====================
package notification {
    enum NotificationType {
        NEW_RECIPE
        SAVE_RECIPE
    }

    enum NotificationFilter {
        ALL
        READ
        UNREAD
    }

    class NotificationListRequest {
        + filter: NotificationFilter
        + page: int
        + size: int
    }

    class NotificationDto {
        + notificationId: Long
        + type: NotificationType
        + title: String
        + message: String
        + recipeId: Long
        + read: boolean
        + createdAt: LocalDateTime
    }

    NotificationListRequest --> NotificationFilter
    NotificationDto --> NotificationType
    note bottom of NotificationDto
      응답: PageResponse<NotificationDto>
      Today / Yesterday 그룹핑은 createdAt 으로 클라이언트에서
    end note
}

' ===================== Profile =====================
package profile {
    enum ProfileTab {
        RECIPE
        VIDEO
        TAG
    }

    class ProfileResponse {
        + userId: Long
        + name: String
        + profileImageUrl: String
        + job: String
        + bio: String
        + recipeCount: int
        + followerCount: long
        + followingCount: long
        + me: boolean
        + following: boolean
    }

    class ProfileRecipeRequest {
        + tab: ProfileTab
        + page: int
        + size: int
    }

    class FollowResponse {
        + userId: Long
        + following: boolean
        + followerCount: long
    }

    ProfileRecipeRequest --> ProfileTab
    note bottom of ProfileRecipeRequest
      응답: PageResponse<RecipeCardDto>
    end note
}

@enduml

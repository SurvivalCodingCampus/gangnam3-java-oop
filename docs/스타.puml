@startuml

' 시나리오
'
' 사장님이 좋아하는 설계로 짬
' 건물 짓고 1cm 옮길 수 있을 정도의 구조
' 완전 MVP 작업을 하는 중

' 아무 기능도 없지만 다른 추가 기능이 들어올 수 있으니...
' 단순히 타입만 나타내는 거면 변수가 좋겠죠?

interface Structure {
}

interface Bionic {
}

interface Terran {
}

interface Zerg extends SmoothlyHealing {
}

interface Protoss extends SmoothlyHealingBarrier, Barrierable {
}

interface Mechanic extends Repairable {
}

interface Unit extends Moveable {
}

interface Mineable {
    int extract();
}

interface Miner {
    void harvest(Mineable mineable);
}

interface Producer {
    void produce(Producible);
}

interface Producible {
    Unit spawn()
}

interface TakeHealable {
    void takeHeal(int amount);
}

interface Healable {
    void heal(TakeHealable takeHealable);
}

interface Repairable {
    void repair(TakeRepairable takeRepairable);
}

interface TakeRepairable {
    void takeRepair(int amount);
}

interface Attackable {
    void attack(Damageable damageable);
}


interface Damageable {
    void takeDamage(int amount);
}

interface Moveable {
    void move(Vector2 direction);
}

interface Barrierable {
    void setBarrier(int amount);
}

interface SmoothlyHealing {
    void smoothlyHealing();
}

interface SmoothlyHealingBarrier {
    void smoothlyHealingBarrier();
}

class player {
    static int oreAmount = 0;
}

class Ore implements Mineable {
    int amount;
}

' 테란

class Marine implements Attackable, TakeHealable, Unit, Bionic, Damageable, Producible, Terran {
    int hp;
}

class Medic implements Healable, Unit, Bionic, TakeHealable, Damageable, Producible, Terran {
    int hp;
}

class Tank implements Unit, TakeRepairable, Damageable, Attackable, Producible, Terran {
    int hp;
}

class Vulture implements Unit, TakeRepairable, Damageable, Attackable, Producible, Terran {
    int hp;
}

class SCV implements Unit, TakeRepairable, Miner, Damageable, Repairable, Producible, Terran {
    int hp;
}


' 저그

class Zergling implements Unit, Bionic, TakeHealable, Damageable, Attackable, Producible, Zerg {
    int hp;
}

class Hydra implements Unit, Bionic, TakeHealable, Damageable, Attackable, Producible, Zerg {
    int hp;
}

abstract class ZergStructure implements Unit, Bionic, Structure, Damageable, Zerg {
    int hp;
}

' 프로토스

class Zealot implements Unit, TakeHealable, Damageable, Attackable, Producible, Protoss {
    int barrierAmount;
    int hp;
}

class Dragun implements Unit, Damageable, Attackable, Producible, Protoss {
    int barrierAmount;
    int hp;
}

class GroupManager {
    void group(Set<Unit> units);
    void attack(Set<Attackable> attackables);
    void move(Set<Unit> units);
}

GroupManager ..> Unit
GroupManager ..> Attackable

Miner ..> Mineable
Healable ..> TakeHealable
Repairable ..> TakeRepairable
Attackable ..> Damageable

Producer ..> Unit

@enduml